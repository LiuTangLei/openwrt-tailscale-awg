#!/bin/sh
# Tailscale-AWG for ASUS: persistent gzip payloads, RAM execution.
# No opkg/apk, Entware packages, firmware changes or NVRAM writes.
# BusyBox ash (including ASUS 1.24) and dash both support local variables.
# shellcheck disable=SC3043
set -eu
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin:/opt/sbin:/opt/bin
export PATH

HOME_DIR=${TS_ASUS_HOME:-/jffs/addons/tailscale-awg}
RUN_DIR=${TS_ASUS_RUN:-/tmp/tailscale-awg}
REPO=LiuTangLei/openwrt-tailscale-awg
# build.py pins the full manifest with the self digest blanked out. The
# downloaded self digest and the payload are verified separately.
MANIFEST_ARM64_CONTENT_SHA256=dae5924287f9cf224d16f0b33a4a6866c726b56e21ee51d296df1f04a4fd4722
MANIFEST_ARMV7_CONTENT_SHA256=365301161411beb42e71672c5afcb59490d1e2f1aeae0d3d3cd593f2af194719
DEFAULT_MIRRORS='https://gh-proxy.org https://ghfast.top direct'
CUSTOM_MIRROR=''
SELF=$(readlink -f "$0")
STAGE=
RECOVER=false
RECOVER_SLOT=
RECOVER_CANDIDATE=
RECOVER_NEW=false
die() { echo "tailscale-asus: $*" >&2; exit 1; }
note() { echo "tailscale-asus: $*"; }
valid_id() { case "$1" in ''|*[!a-zA-Z0-9._-]*|.*) return 1;; esac; }
safe_path() { case "$1" in /*) ;; *) die "absolute path required: $1";; esac; case "$1" in *[!a-zA-Z0-9/._-]*|/|*/../*|*/..|*/./*) die "unsafe installation path";; esac; }
safe_path "$HOME_DIR"; safe_path "$RUN_DIR"
case "$RUN_DIR" in /tmp/*) ;; *) die "runtime must be under /tmp";; esac
[ "$HOME_DIR" != "$RUN_DIR" ] || die "persistent and runtime paths must differ"
export TS_ASUS_HOME="$HOME_DIR" TS_ASUS_RUN="$RUN_DIR"

sha() {
    local digest
    if type sha256sum >/dev/null 2>&1; then
        digest=$(sha256sum "$1") || return
        printf '%s\n' "${digest%% *}"
    else
        # ET8 Gnuton firmware has OpenSSL but no SHA-256 BusyBox applet.
        digest=$(openssl dgst -sha256 "$1") || return
        printf '%s\n' "${digest##* }"
    fi
}
field() { awk -F= -v key="$2" '$1==key {n++; value=substr($0,index($0,"=")+1)} END {if(n!=1) exit 1; print value}' "$1"; }
pointer() {
    [ -f "$HOME_DIR/$1" ] || return 0
    local value
    value=$(cat "$HOME_DIR/$1")
    valid_id "$value" || die "invalid $1 pointer"
    printf '%s\n' "$value"
}
put_pointer() { printf '%s\n' "$2" > "$HOME_DIR/$1.new"; mv -f "$HOME_DIR/$1.new" "$HOME_DIR/$1"; }
cleanup() {
    if [ "$RECOVER" = true ]; then
        RECOVER=false
        stop_service
        if [ -n "$RECOVER_SLOT" ]; then
            put_pointer current "$RECOVER_SLOT"
            start_service || note "recovery needs attention; compressed previous release and identity remain on flash"
        else rm -f "$HOME_DIR/current"; fi
        if [ -n "$RECOVER_CANDIDATE" ] && [ "$RECOVER_CANDIDATE" != "$RECOVER_SLOT" ]; then
            rm -rf "$RUN_DIR/instances/$RECOVER_CANDIDATE"
            if [ "$RECOVER_NEW" = true ]; then rm -rf "$HOME_DIR/releases/$RECOVER_CANDIDATE"; fi
        fi
        rm -f "$HOME_DIR/pending"
        sync
    fi
    [ -z "$STAGE" ] || rm -rf "$STAGE"
}
lock() {
    [ "$(awk '/^Uid:/ {print $3}' /proc/self/status)" = 0 ] || die "run as root"
    [ ! -L "$RUN_DIR" ] && [ ! -L "$HOME_DIR" ] || die "installation directories must not be symlinks"
    mkdir -p "$RUN_DIR" "$HOME_DIR"
    chmod 700 "$RUN_DIR" "$HOME_DIR"
    exec 9>"$RUN_DIR/lock"
    flock -n 9 || die "another lifecycle operation is running"
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
}
detect_arch() {
    case "$(uname -m)" in aarch64|arm64) ARCH=arm64;; armv7l|armv8l) ARCH=armv7;; *) die "supported architectures: ARM64 and ARMv7";; esac
    local kernel major minor
    kernel=$(uname -r); major=${kernel%%.*}; kernel=${kernel#*.}; minor=${kernel%%.*}
    [ "$major" -gt 3 ] || { [ "$major" -eq 3 ] && [ "$minor" -ge 2 ]; } || die "Go requires Linux 3.2 or newer (old 2.6 ASUS kernels are unsupported)"
}
detect_platform() {
    if [ "$PLATFORM" = auto ]; then
        if [ -x /rom/etc/init.d/custom-init.sh ] && [ -e /rom/etc/rc3.d/S45custom-init ]; then PLATFORM=stock
        elif type nvram >/dev/null 2>&1 && nvram get rc_support | grep -qw am_addons; then PLATFORM=merlin
        elif [ -x /opt/etc/init.d/rc.unslung ]; then PLATFORM=entware
        else die "no supported boot hook (checked /rom/etc/init.d/custom-init.sh + /rom/etc/rc3.d/S45custom-init, Merlin am_addons, and /opt/etc/init.d/rc.unslung); stock firmware needs an existing fwtool custom-init or Entware startup hook"; fi
    fi
    case "$PLATFORM" in
        stock) [ -x /rom/etc/init.d/custom-init.sh ] && [ -e /rom/etc/rc3.d/S45custom-init ] || die "stock custom-init hook is missing (/rom/etc/init.d/custom-init.sh or /rom/etc/rc3.d/S45custom-init)";;
        merlin) [ "$(nvram get jffs2_scripts)" = 1 ] || die "enable JFFS custom scripts in Merlin's Administration / System first";;
        entware) [ -x /opt/etc/init.d/rc.unslung ] || die "Entware boot setup is missing (/opt/etc/init.d/rc.unslung)";;
        *) die "platform must be auto, stock, merlin or entware";;
    esac
}
manifest_check() {
    local manifest=$1
    [ "$(field "$manifest" format)" = 1 ] || die "unsupported manifest"
    RELEASE=$(field "$manifest" release); valid_id "$RELEASE" || die "invalid release"
    [ "$(field "$manifest" arch)" = "$ARCH" ] || die "wrong architecture"
    CORE_SHA=$(field "$manifest" core)
    [ "${#CORE_SHA}" = 40 ] || die "invalid core digest"
    case "$CORE_SHA" in *[!0-9a-f]*) die "invalid core digest";; esac
    ARCHIVE_SHA=$(field "$manifest" sha256); BINARY_SHA=$(field "$manifest" binary_sha256)
    MANAGER_SHA=$(field "$manifest" manager_sha256); BINARY_BYTES=$(field "$manifest" binary_bytes)
    for digest in "$ARCHIVE_SHA" "$BINARY_SHA" "$MANAGER_SHA"; do
        [ "${#digest}" = 64 ] || die "invalid digest"
        case "$digest" in *[!0-9a-f]*) die "invalid digest";; esac
    done
    case "$BINARY_BYTES" in ''|*[!0-9]*|0*) die "invalid binary size";; esac
    [ "$BINARY_BYTES" -le 134217728 ] || die "binary exceeds 128 MiB"
    SLOT="$RELEASE-$ARCH"
}
space_check() {
    local archive=$1 need_kb free_kb available
    need_kb=$(( (BINARY_BYTES + $(wc -c < "$archive")) / 1024 + 65536 ))
    free_kb=$(df -k "$RUN_DIR" | awk 'END {print $4}')
    available=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
    [ -n "$available" ] || available=$(awk '/^MemFree:/ {print $2}' /proc/meminfo)
    [ "$free_kb" -ge "$need_kb" ] && [ "$available" -ge "$need_kb" ] || die "insufficient RAM: need an additional ${need_kb} KiB including 64 MiB headroom"
}
unpack() {
    local archive=$1 target=$2
    [ "$(sha "$archive")" = "$ARCHIVE_SHA" ] || die "compressed payload checksum mismatch"
    space_check "$archive"
    mkdir -p "$target"
    gzip -dc "$archive" > "$target/tailscaled.new" || die "decompression failed"
    [ "$(wc -c < "$target/tailscaled.new" | tr -d ' ')" = "$BINARY_BYTES" ] || die "binary size mismatch"
    [ "$(sha "$target/tailscaled.new")" = "$BINARY_SHA" ] || die "binary checksum mismatch"
    chmod 700 "$target/tailscaled.new"
    "$target/tailscaled.new" --version > "$target/version.txt" || die "binary cannot execute on this kernel/CPU"
    grep -F "$CORE_SHA" "$target/version.txt" >/dev/null || die "binary core identity mismatch"
    mv -f "$target/tailscaled.new" "$target/tailscaled"
    ln -sf tailscaled "$target/tailscale"
}
pid_matches() {
    # A recycled PID or another tailscaled is never a stop target.
    [ -f "$RUN_DIR/$1.pid" ] || return 1
    local pid ticks actual
    read -r pid ticks < "$RUN_DIR/$1.pid"
    case "$pid:$ticks" in *[!0-9:]*|:*) return 1;; esac
    [ -r "/proc/$pid/stat" ] || return 1
    [ "$(awk '{print $22}' "/proc/$pid/stat")" = "$ticks" ] || return 1
    if [ "$1" = daemon ]; then
        actual=$(readlink "/proc/$pid/exe")
        case "$actual" in "$RUN_DIR"/instances/*/tailscaled) ;; *) return 1;; esac
    else
        tr '\000' '\n' < "/proc/$pid/cmdline" | grep -Fx "$HOME_DIR/releases/$(pointer current)/manager" >/dev/null || return 1
    fi
    PID=$pid
}
save_pid() { printf '%s %s\n' "$2" "$(awk '{print $22}' "/proc/$2/stat")" > "$RUN_DIR/$1.pid"; }
stop_service() {
    local count=0
    if pid_matches worker; then kill -TERM "$PID"; fi
    if pid_matches daemon; then kill -TERM "$PID"; fi
    while [ "$count" -lt 5 ]; do
        if ! pid_matches daemon && ! pid_matches worker; then break; fi
        sleep 1; count=$((count+1))
    done
    if pid_matches daemon; then kill -KILL "$PID"; fi
    if pid_matches worker; then kill -KILL "$PID"; fi
    rm -f "$RUN_DIR/worker.pid" "$RUN_DIR/daemon.pid" "$RUN_DIR/tailscaled.sock"
}
load_tun() {
    if [ ! -c /dev/net/tun ]; then
        modprobe tun || die "kernel TUN support is unavailable"
        mkdir -p /dev/net
        [ -c /dev/net/tun ] || mknod /dev/net/tun c 10 200
    fi
}
start_service() {
    if pid_matches daemon && [ -S "$RUN_DIR/tailscaled.sock" ]; then return 0; fi
    # A missing RAM socket does not mean the existing daemon has stopped.
    if pid_matches daemon || pid_matches worker; then stop_service; fi
    local slot bin foreign deadline
    slot=$(pointer current); [ -n "$slot" ] || die "nothing installed"
    bin="$RUN_DIR/instances/$slot"
    for foreign in $(pidof tailscaled 2>/dev/null || true); do
        case "$(readlink "/proc/$foreign/exe" 2>/dev/null || true)" in "$RUN_DIR"/instances/*/tailscaled) ;; *) die "another tailscaled is running; refusing to replace it";; esac
    done
    detect_arch
    manifest_check "$HOME_DIR/releases/$slot/manifest"
    curl --version | grep -qw UnixSockets || die "curl with UnixSockets support is required"
    [ "$(sha "$HOME_DIR/releases/$slot/manager")" = "$MANAGER_SHA" ] || die "stored manager checksum mismatch"
    if [ ! -x "$bin/tailscaled" ] || [ "$(sha "$bin/tailscaled")" != "$BINARY_SHA" ]; then unpack "$HOME_DIR/releases/$slot/payload.gz" "$bin"; fi
    load_tun
    mkdir -p "$HOME_DIR/state"
    chmod 700 "$HOME_DIR/state"
    # The worker and daemon must not inherit the lifecycle flock or the SSH tty.
    # Defer cancellation across fork/PID registration so cleanup can always
    # identify the child; caught traps reset normally in the new shell.
    START_CANCEL=''
    trap 'START_CANCEL=130' INT
    trap 'START_CANCEL=143' TERM HUP
    nohup /bin/sh "$HOME_DIR/releases/$slot/manager" _serve "$slot" </dev/null >/dev/null 2>&1 9>&- &
    save_pid worker "$!"
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    [ -z "$START_CANCEL" ] || exit "$START_CANCEL"
    deadline=$(( $(awk '{print int($1)}' /proc/uptime) + 20 ))
    while [ "$(awk '{print int($1)}' /proc/uptime)" -lt "$deadline" ]; do
        if [ -S "$RUN_DIR/tailscaled.sock" ] && pid_matches daemon &&
            curl --silent --fail --max-time 1 --unix-socket "$RUN_DIR/tailscaled.sock" \
                http://local-tailscaled.sock/localapi/v0/status >/dev/null 2>&1 9>&-; then
            note "ready: $slot (binary/logs/socket in RAM; identity in $HOME_DIR/state)"
            return 0
        fi
        sleep 1 9>&-
    done
    stop_service
    return 1
}
serve() {
    local slot=$1 bin child='' logger='' fifo="$RUN_DIR/log.pipe" expected4=false expected6=false family
    bin="$RUN_DIR/instances/$slot"
    trap 'if pid_matches daemon; then kill -TERM "$PID" 2>/dev/null || true; fi; exit 0' TERM INT HUP
    rm -f "$fifo"; mknod "$fifo" p; chmod 600 "$fifo"
    # Never write daemon logs to JFFS. Truncate at 256 KiB, even during log storms.
    awk -v logfile="$RUN_DIR/daemon.log" ' {line=substr($0,1,16384); if(size+length(line)+1>262144){close(logfile);size=0} print line > logfile; size+=length(line)+1; fflush(logfile)}' < "$fifo" &
    logger=$!
    "$bin/tailscaled" --statedir="$HOME_DIR/state" --socket="$RUN_DIR/tailscaled.sock" --tun=tailscale0 --port=41641 > "$fifo" 2>&1 &
    child=$!; save_pid daemon "$child"
    while kill -0 "$child" 2>/dev/null; do
        sleep 3
        # Stock firmware can flush netfilter without invoking a user hook.
        # Only observe Tailscale's own established jumps; let the daemon rebuild.
        for family in 4 6; do
            if [ "$family" = 4 ]; then tool=iptables; expected=$expected4; else tool=ip6tables; expected=$expected6; fi
            if "$tool" -C INPUT -j ts-input >/dev/null 2>&1; then
                if [ "$family" = 4 ]; then expected4=true; else expected6=true; fi
            elif [ "$expected" = true ]; then
                kill -TERM "$child" 2>/dev/null || true
                wait "$child" || true
                wait "$logger" || true
                rm -f "$RUN_DIR/daemon.pid" "$RUN_DIR/worker.pid" "$fifo"
                exec "$HOME_DIR/tailscale-asus" start
            fi
        done
    done
    wait "$child" || true
    wait "$logger" || true
    rm -f "$RUN_DIR/daemon.pid" "$RUN_DIR/worker.pid" "$fifo"
    sleep 3
    exec "$HOME_DIR/tailscale-asus" start
}
hook_paths() {
    case "$PLATFORM" in
        stock) echo /jffs/scripts/custom-init/tailscale-awg;;
        merlin) printf '%s\n' /jffs/scripts/services-start /jffs/scripts/services-stop /jffs/scripts/firewall-start;;
        entware) echo /opt/etc/init.d/S98tailscale-awg;;
    esac
}
hooks_check() {
    local path recorded
    for path in $(hook_paths); do
        if [ -f "$HOME_DIR/hooks.sha256" ] && grep -F "  $path" "$HOME_DIR/hooks.sha256" >/dev/null; then
            recorded=$(awk -v path="$path" '$2==path {print $1}' "$HOME_DIR/hooks.sha256")
            [ -f "$path" ] && [ "$(sha "$path")" = "$recorded" ] || die "managed hook was changed: $path; preserve it and resolve manually"
        elif [ "$PLATFORM" != merlin ] && { [ -e "$path" ] || [ -L "$path" ]; }; then die "hook already exists: $path"
        elif [ -e "$path.tailscale-asus.original" ] || [ -L "$path.tailscale-asus.original" ]; then die "hook backup already exists: $path.tailscale-asus.original"; fi
    done
}
hooks_install() {
    local path backup action digest
    : > "$HOME_DIR/hooks.sha256.new"
    for path in $(hook_paths); do
        backup="$path.tailscale-asus.original"
        mkdir -p "$(dirname "$path")"
        if [ "$PLATFORM" = merlin ] && ! { [ -f "$HOME_DIR/hooks.sha256" ] && grep -F "  $path" "$HOME_DIR/hooks.sha256" >/dev/null; }; then
            # Copy first: a power cut before the wrapper rename leaves the
            # original hook in place. -P preserves relative symlinks as links.
            if [ -e "$path" ] || [ -L "$path" ]; then cp -pP "$path" "$backup"; fi
        fi
        case "$path" in */services-stop) action=stop;; */firewall-start) action=restart;; */services-start) action=boot;; *) action='${1:-start}';; esac
        {
            echo '#!/bin/sh'
            echo '# tailscale-asus managed hook v1; preserve the original interpreter.'
            echo "export TS_ASUS_HOME='$HOME_DIR' TS_ASUS_RUN='$RUN_DIR'"
            if [ "$PLATFORM" = merlin ] && [ "$action" != stop ] && [ -x "$backup" ]; then printf '%s "$@"\nrc=$?\n' "'$backup'"; else echo 'rc=0'; fi
            if [ "$action" = stop ]; then
                printf '"%s/tailscale-asus" stop >/dev/null 2>&1\n' "$HOME_DIR"
            elif [ "$action" = '${1:-start}' ]; then
                printf 'case "${1:-start}" in\nstop) "%s/tailscale-asus" stop >/dev/null 2>&1;;\nstart|restart) "%s/tailscale-asus" "${1:-start}" >/dev/null 2>&1 & ;;\nesac\n' "$HOME_DIR" "$HOME_DIR"
            else printf '"%s/tailscale-asus" %s >/dev/null 2>&1 &\n' "$HOME_DIR" "$action"; fi
            if [ "$PLATFORM" = merlin ] && [ "$action" = stop ] && [ -x "$backup" ]; then printf '%s "$@"\nrc=$?\n' "'$backup'"; fi
            echo 'exit "$rc"'
        } > "$path.new"
        chmod 755 "$path.new"; mv -f "$path.new" "$path"
        digest=$(sha "$path")
        printf '%s  %s\n' "$digest" "$path" >> "$HOME_DIR/hooks.sha256.new"
    done
    mv -f "$HOME_DIR/hooks.sha256.new" "$HOME_DIR/hooks.sha256"
}
set_mirror() {
    case "$1" in
        https://*[!a-zA-Z0-9./:_~-]*) die "mirror requires an HTTPS prefix: $1";;
        https://?*) CUSTOM_MIRROR=${1%/};;
        *) die "mirror requires an HTTPS prefix: $1";;
    esac
}
fetch_url() {
    rm -f "$2.part"
    if curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --tlsv1.2 \
        --connect-timeout "$3" --max-time "$4" "$1" -o "$2.part"; then
        mv -f "$2.part" "$2"
    else
        rm -f "$2.part"
        return 1
    fi
}
download_release() {
    local base="https://github.com/$REPO/releases/download/$REQUESTED" asset="tailscale-asus-$REQUESTED-$ARCH.gz"
    local mirrors=$DEFAULT_MIRRORS mirror prefix pinned self_sha
    case "$ARCH" in arm64) pinned=$MANIFEST_ARM64_CONTENT_SHA256;; *) pinned=$MANIFEST_ARMV7_CONTENT_SHA256;; esac
    self_sha=$(sha "$SELF")
    [ -z "$CUSTOM_MIRROR" ] || mirrors="$CUSTOM_MIRROR $mirrors"
    # Every source must deliver a complete, verified pair; any failure tries
    # the next source instead of committing to the first HTTP 200 response.
    for mirror in $mirrors; do
        case "$mirror" in direct) prefix='';; *) prefix=$mirror/;; esac
        rm -f "$STAGE/manifest" "$STAGE/payload.gz"
        note "checking $mirror"
        if ! fetch_url "$prefix$base/$asset.manifest" "$STAGE/manifest" 10 30; then continue; fi
        sed 's/^manager_sha256=.*/manager_sha256=/' "$STAGE/manifest" > "$STAGE/manifest.content"
        if [ "$(sha "$STAGE/manifest.content")" != "$pinned" ] ||
           [ "$(field "$STAGE/manifest" manager_sha256 2>/dev/null || true)" != "$self_sha" ] ||
           [ "$(field "$STAGE/manifest" release 2>/dev/null || true)" != "$REQUESTED" ]; then
            note "invalid or stale manifest from $mirror; trying another source"
            continue
        fi
        if fetch_url "$prefix$base/$asset" "$STAGE/payload.gz" 15 300 &&
           [ "$(sha "$STAGE/payload.gz")" = "$(field "$STAGE/manifest" sha256)" ]; then
            return 0
        fi
        note "payload download or checksum failed from $mirror; trying another source"
    done
    rm -f "$STAGE/manifest" "$STAGE/payload.gz"
    die "no verified source for $REQUESTED; use tailscale-asus from that same release (active release is untouched)"
}
confirm() { local reply; printf '%s [y/N]: ' "$1"; read -r reply || return 1; case "$reply" in y|Y|yes|YES) return 0;; *) return 1;; esac; }
run_menu() {
    [ "$(awk '/^Uid:/ {print $3}' /proc/self/status)" = 0 ] || die "run as root"
    [ -x "$HOME_DIR/tailscale-asus" ] && [ -n "$(pointer current)" ] || die "nothing installed"
    local launcher="$HOME_DIR/tailscale-asus" choice server first_line before
    STAGE="/tmp/tailscale-asus-update.$$"
    trap '[ -z "$STAGE" ] || rm -rf "$STAGE"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    while :; do
        printf '\n华硕 Tailscale AWG / QUIC\n1) 状态\n2) 登录 / 控制服务器\n3) 配置 AWG / QUIC\n4) 重启服务\n5) 日志\n6) 检查更新\n7) 回滚\n8) 卸载（保留身份）\n0) 退出\n请选择: '
        read -r choice || return 0
        case "$choice" in
            1) "$launcher" status || true; "$launcher" cli status || true;;
            2)
                printf '控制服务器 HTTPS 地址（留空使用官方 Tailscale）: '
                read -r server || return 0
                case "$server" in
                    '') "$launcher" cli up --accept-dns=false --accept-routes=false || true;;
                    https://*) "$launcher" cli up --login-server="$server" --accept-dns=false --accept-routes=false || true;;
                    *) echo '请输入 https:// 开头的地址';;
                esac;;
            3)
                if "$launcher" cli awg set --no-restart; then
                    if confirm '重启服务以应用配置？'; then "$launcher" restart || true; fi
                fi;;
            4) "$launcher" restart || true;;
            5) if [ -f "$RUN_DIR/daemon.log" ]; then tail -n 60 "$RUN_DIR/daemon.log"; else echo '暂无日志'; fi;;
            6)
                # The update script runs as root, so only GitHub's TLS origin may
                # supply it. The custom mirror is forwarded for the payloads that
                # script verifies against pinned digests; old scripts ignore it.
                rm -rf "$STAGE"
                if mkdir "$STAGE" && fetch_url "https://github.com/$REPO/releases/latest/download/install-asus.sh" "$STAGE/update.sh" 5 30; then
                    first_line=''
                    IFS= read -r first_line <"$STAGE/update.sh" || true
                    if [ "$first_line" = '#!/bin/sh' ] && /bin/sh -n "$STAGE/update.sh"; then
                        before=$(pointer current)
                        if TS_ASUS_MIRROR="$CUSTOM_MIRROR" /bin/sh "$STAGE/update.sh" --no-menu; then
                            if [ "$(pointer current)" != "$before" ]; then
                                rm -rf "$STAGE"
                                echo "已更新到 $(pointer current)；请重新打开菜单：$launcher menu"
                                return 0
                            fi
                            echo '已是最新版本'
                        else
                            echo '更新未完成，请查看上方错误'
                        fi
                    else
                        echo 'GitHub 返回的更新脚本无效，当前服务未改动'
                    fi
                else
                    echo '无法直接从 GitHub 下载更新脚本，当前服务未改动。'
                    echo '请在能访问 GitHub 的电脑上下载官方安装脚本，再传到路由器运行。'
                    echo "  https://github.com/$REPO/releases/latest/download/install-asus.sh"
                fi
                rm -rf "$STAGE";;
            7) if confirm '回滚到上一个已安装版本？'; then "$launcher" rollback || true; fi;;
            8) if confirm '卸载程序，保留节点身份？'; then "$launcher" uninstall && return 0; fi;;
            0|q|Q) return 0;;
            *) echo '请选择 0–8';;
        esac
    done
}
recover_pending() {
    [ -f "$HOME_DIR/pending" ] || return 0
    local previous
    previous=$(pointer pending)
    # pending is durable before activation. A crash never commits a release
    # whose readiness/hook installation was not completed.
    if [ "$previous" != none ]; then
        stop_service
        put_pointer current "$previous"
        start_service || die "interrupted update restored previous payload, but daemon needs attention"
        note "recovered interrupted update to $previous"
    fi
    rm -f "$HOME_DIR/pending"
    sync
}
install_release() {
    recover_pending
    detect_arch
    detect_platform
    [ ! -f "$HOME_DIR/platform" ] || [ "$(cat "$HOME_DIR/platform")" = "$PLATFORM" ] || die "use the original platform when updating"
    hooks_check
    STAGE="$RUN_DIR/install.$$"
    mkdir "$STAGE" || die "cannot create RAM staging directory"
    if [ -z "$BUNDLE" ]; then
        valid_id "$REQUESTED" || die "install requires an explicit --release"
        download_release
    else cp "$MANIFEST" "$STAGE/manifest"; cp "$BUNDLE" "$STAGE/payload.gz"; fi
    manifest_check "$STAGE/manifest"
    [ "$CORE_SHA" = a32d18362c987e5007eab9f76c69118947a7b047 ] || die "unexpected core"
    [ "$(field "$STAGE/manifest" core_tag)" = v1.104.7 ] || die "unexpected core tag"
    [ "$(field "$STAGE/manifest" quic)" = v0.65.0-quic.4 ] || die "unexpected QUIC version"
    [ -z "$REQUESTED" ] || [ "$REQUESTED" = "$RELEASE" ] || die "release mismatch"
    [ "$(sha "$SELF")" = "$MANAGER_SHA" ] || die "installer/manifest mismatch; download the installer from the same release"
    cp "$SELF" "$STAGE/manager"; chmod 700 "$STAGE/manager"
    unpack "$STAGE/payload.gz" "$STAGE/bin"
    local old previous free_kb need_kb reclaim=0 destination="$HOME_DIR/releases/$SLOT"
    old=$(pointer current); previous=$(pointer previous)
    for entry in "$HOME_DIR"/releases/.incoming-*; do [ ! -d "$entry" ] || rm -rf "$entry"; done
    # A power cut after the flash rename but before pending is written can
    # leave an unreferenced payload. Reclaim only our inactive cache slots.
    for entry in "$HOME_DIR"/releases/*; do
        [ -d "$entry" ] || continue
        case "${entry##*/}" in "$old"|"$previous"|"$SLOT") ;; *) rm -rf "$entry";; esac
    done
    if [ -d "$destination" ]; then
        [ "$(sha "$destination/manifest")" = "$(sha "$STAGE/manifest")" ] && [ "$(sha "$destination/payload.gz")" = "$ARCHIVE_SHA" ] || die "release already exists with different content"
    else
        need_kb=$(( $(du -k "$STAGE/payload.gz" | awk '{print $1}') + 4096 ))
        free_kb=$(df -k "$HOME_DIR" | awk 'END {print $4}')
        if [ -n "$previous" ] && [ "$previous" != "$old" ] && [ -d "$HOME_DIR/releases/$previous" ]; then reclaim=$(du -sk "$HOME_DIR/releases/$previous" | awk '{print $1}'); fi
        [ $((free_kb+reclaim)) -ge "$need_kb" ] || die "insufficient flash for active + candidate compressed payloads and 4 MiB reserve; active release is untouched"
        # Only the older rollback slot may be pruned. Keep the active payload
        # persistent throughout, including power loss during a failed update.
        if [ "$free_kb" -lt "$need_kb" ] && [ "$reclaim" -gt 0 ]; then rm -rf "$HOME_DIR/releases/$previous"; rm -f "$HOME_DIR/previous"; fi
        mkdir -p "$HOME_DIR/releases/.incoming-$SLOT"
        cp "$STAGE/payload.gz" "$STAGE/manifest" "$STAGE/manager" "$HOME_DIR/releases/.incoming-$SLOT/"
        [ "$(sha "$HOME_DIR/releases/.incoming-$SLOT/payload.gz")" = "$ARCHIVE_SHA" ] || die "flash copy verification failed"
        [ "$(sha "$HOME_DIR/releases/.incoming-$SLOT/manager")" = "$MANAGER_SHA" ] || die "flash manager verification failed"
        cmp "$STAGE/manifest" "$HOME_DIR/releases/.incoming-$SLOT/manifest" || die "flash manifest verification failed"
        sync
        mv "$HOME_DIR/releases/.incoming-$SLOT" "$destination"
        RECOVER_NEW=true
    fi
    mkdir -p "$RUN_DIR/instances"
    if [ "$old" != "$SLOT" ]; then
        [ ! -d "$RUN_DIR/instances/$SLOT" ] || rm -rf "$RUN_DIR/instances/$SLOT"
        mv "$STAGE/bin" "$RUN_DIR/instances/$SLOT"
    elif [ ! -d "$RUN_DIR/instances/$SLOT" ]; then mv "$STAGE/bin" "$RUN_DIR/instances/$SLOT"; fi
    put_pointer pending "${old:-none}"
    sync
    RECOVER_SLOT=$old; RECOVER_CANDIDATE=$SLOT; RECOVER=true
    stop_service
    [ -z "$old" ] || [ "$old" = "$SLOT" ] || put_pointer previous "$old"
    put_pointer current "$SLOT"
    # This stable launcher contains no release-specific code or binary.
    cat > "$HOME_DIR/tailscale-asus.new" <<EOF
#!/bin/sh
set -eu
export TS_ASUS_HOME='$HOME_DIR' TS_ASUS_RUN='$RUN_DIR'
read -r slot < '$HOME_DIR/current'
case "\$slot" in ''|*[!a-zA-Z0-9._-]*|.*) exit 1;; esac
exec /bin/sh '$HOME_DIR/releases/'"\$slot"'/manager' "\$@"
EOF
    chmod 700 "$HOME_DIR/tailscale-asus.new"; mv -f "$HOME_DIR/tailscale-asus.new" "$HOME_DIR/tailscale-asus"
    if ! start_service; then
        die "candidate startup failed; restoring previous active release when available"
    fi
    printf '%s\n' "$PLATFORM" > "$HOME_DIR/platform"
    hooks_install
    sync
    rm -f "$HOME_DIR/pending"
    sync
    RECOVER=false
    # Only current and rollback payloads are retained; never touch state.
    previous=$(pointer previous)
    for entry in "$HOME_DIR"/releases/*; do
        [ -d "$entry" ] || continue
        case "${entry##*/}" in "$SLOT"|"$previous") ;; *) rm -rf "$entry";; esac
    done
    note "installed $RELEASE ($PLATFORM). Login explicitly with: $HOME_DIR/tailscale-asus cli up --accept-dns=false --accept-routes=false"
}
uninstall() {
    [ -f "$HOME_DIR/platform" ] || die "nothing installed"
    PLATFORM=$(cat "$HOME_DIR/platform"); hooks_check
    stop_service
    local path
    for path in $(hook_paths); do
        rm -f "$path"
        if [ -e "$path.tailscale-asus.original" ] || [ -L "$path.tailscale-asus.original" ]; then mv "$path.tailscale-asus.original" "$path"; fi
    done
    rm -rf "$HOME_DIR/releases" "$RUN_DIR/instances"
    rm -f "$HOME_DIR/current" "$HOME_DIR/previous" "$HOME_DIR/pending" "$HOME_DIR/platform" "$HOME_DIR/hooks.sha256" "$HOME_DIR/tailscale-asus"
    note "removed program/hooks; identity state retained in $HOME_DIR/state"
}
usage() {
    cat <<'EOF'
Tailscale-AWG ASUS manager (stock custom-init, Merlin or existing Entware)
  install --release TAG [--platform auto|stock|merlin|entware] [--mirror PREFIX]
  install --bundle FILE.gz --manifest FILE.manifest [--platform ...]
  menu [--mirror PREFIX]
  start | stop | restart | status | rollback | uninstall
  cli [tailscale arguments...]
Compressed releases and state: /jffs/addons/tailscale-awg
Unpacked binary, bounded log and socket: /tmp/tailscale-awg
TS_ASUS_HOME selects other persistent storage; TS_ASUS_RUN must be under /tmp.
TS_ASUS_MIRROR sets a preferred HTTPS mirror for checksum-pinned downloads only;
menu updates fetch the root installer script from GitHub directly.
`install --release` validates the manifest and payload pinned to this manager.
Uninstall keeps identity. No automatic upgrades or firmware/NVRAM changes.
EOF
}
COMMAND=${1:-help}; [ $# -eq 0 ] || shift
case "$COMMAND" in
    help|--help|-h) usage;;
    _serve) serve "$@";;
    menu)
        CUSTOM_MIRROR=''
        while [ $# -gt 0 ]; do
            case "$1" in
                --mirror) [ $# -ge 2 ] || die "missing option value"; set_mirror "$2"; shift 2;;
                --help|-h) echo 'Usage: tailscale-asus menu [--mirror PREFIX]'; exit 0;;
                *) die "unknown option: $1";;
            esac
        done
        [ -n "$CUSTOM_MIRROR" ] || [ -z "${TS_ASUS_MIRROR:-}" ] || set_mirror "$TS_ASUS_MIRROR"
        run_menu;;
    cli) slot=$(pointer current); [ -n "$slot" ] || die "nothing installed"; exec "$RUN_DIR/instances/$slot/tailscale" --socket="$RUN_DIR/tailscaled.sock" "$@";;
    status) slot=$(pointer current); note "release=${slot:-none}"; if pid_matches daemon; then note "running pid=$PID"; else note stopped; exit 1; fi; df -k "$HOME_DIR" "$RUN_DIR";;
    install)
        REQUESTED='' BUNDLE='' MANIFEST='' PLATFORM=auto CUSTOM_MIRROR=''
        while [ $# -gt 0 ]; do
            [ $# -ge 2 ] || die "missing option value"
            case "$1" in
                --release) REQUESTED=$2;;
                --bundle) BUNDLE=$2;;
                --manifest) MANIFEST=$2;;
                --platform) PLATFORM=$2;;
                --mirror) set_mirror "$2";;
                *) die "unknown option: $1";;
            esac
            shift 2
        done
        [ -n "$CUSTOM_MIRROR" ] || [ -z "${TS_ASUS_MIRROR:-}" ] || set_mirror "$TS_ASUS_MIRROR"
        { [ -z "$BUNDLE" ] && [ -z "$MANIFEST" ]; } || { [ -f "$BUNDLE" ] && [ -f "$MANIFEST" ]; } || die "both bundle and manifest are required"
        lock; install_release;;
    start|boot) lock; recover_pending; start_service;;
    stop) lock; stop_service;;
    restart) lock; stop_service; start_service;;
    rollback)
        lock; old=$(pointer current); previous=$(pointer previous); [ -n "$previous" ] && [ -d "$HOME_DIR/releases/$previous" ] || die "no rollback release"
        stop_service; put_pointer current "$previous"
        if start_service; then put_pointer previous "$old"; sync; else put_pointer current "$old"; start_service || true; die "rollback failed; restored active release"; fi;;
    uninstall) lock; uninstall;;
    *) usage >&2; exit 1;;
esac
